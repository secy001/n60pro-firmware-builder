# 插件配置补充段：在 feeds install -a 之后、make defconfig 之前追加。
# 原因：feeds install -a 会重写 .config（展开成完整 Kconfig 配置），
# 过程中会丢失第三方源包的选择。必须在 feeds install 后重新注入。
# 注意：这里的每一行都必须能在 feeds 的 Kconfig 中找到对应符号。

# CUPS（官方 packages 源 2.3.3）
CONFIG_PACKAGE_cups=y
CONFIG_PACKAGE_cups-filters=y
CONFIG_PACKAGE_cups-client=y
CONFIG_PACKAGE_cups-ppdc=y
CONFIG_PACKAGE_libcups=y
CONFIG_PACKAGE_libcupsimage=y
CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_usbutils=y

# OpenClash（第三方 feed: openclash）
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# iStore（第三方 feed: istore）
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_mount-utils=y
